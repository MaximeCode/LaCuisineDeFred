{
  "kind": "collectionType",
  "collectionName": "produits",
  "info": {
    "singularName": "produit",
    "pluralName": "produits",
    "displayName": "Produits"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Titre": {
      "type": "string",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "details": {
      "type": "blocks"
    },
    "Prix": {
      "type": "decimal"
    },
    "unite": {
      "type": "string",
      "required": true,
      "maxLength": 20
    },
    "categorie": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::categorie.categorie"
    }
  }
}
